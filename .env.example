# Postgres (docker compose maps host 5433 → container 5432)
DATABASE_URL=postgresql://iwealth:iwealth@localhost:5433/iwealth_better

# JWT secret for Bearer tokens (min 16 chars in production)
JWT_SECRET=change-me-jwt-secret-min-16-chars

# HTTP
PORT=3010

# LLM gateway (back-only proxy for POST /compare/summarize)
LLM_GATEWAY_URL=https://ai.develyst.online
# Optional gateway auth header value (never commit real secrets)
# LLM_GATEWAY_AUTH=
